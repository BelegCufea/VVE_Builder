/*
 * IE Voiceover Patcher
 * Attaches WAV voiceovers to existing dialog.tlk strrefs.
 *
 * Built by build_mod.py from the VVE_Builder toolchain - see
 * `build_mod.py --help` for how this mod folder is generated/staged.
 */

BACKUP ~%MOD_NAME%/backup~
AUTHOR ~VVE_Builder~
VERSION ~v1.0~

LANGUAGE ~English~
         ~english~
         ~%MOD_NAME%/TRA/english/setup.tra~

BEGIN @1

PRINT @2
COPY ~%MOD_NAME%/WAV~ ~override~

SILENT

OUTER_SET patched = 0

COPY - ~%MOD_NAME%/mapping.txt~ ~override~
  READ_2DA_ENTRIES_NOW mapping 2

  FOR (row = 0; row < mapping; row = row + 1) BEGIN
    READ_2DA_ENTRY_FORMER mapping row 0 strref
    READ_2DA_ENTRY_FORMER mapping row 1 resref

    INNER_ACTION BEGIN
      ACTION_GET_STRREF strref dialogstring
      STRING_SET_EVALUATE strref ~%dialogstring%~ [%resref%]
      OUTER_SET patched = patched + 1
    END
  END
BUT_ONLY

VERBOSE

PRINT @3