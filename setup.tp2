/*
 * IE Voiceover Patcher
 * Attaches WAV voiceovers to existing dialog.tlk strrefs.
 *
 * Built by build_mod.py from the VVE_Builder toolchain - see
 * `build_mod.py --help` for how this mod folder is generated/staged.
 */

BACKUP ~backup~
AUTHOR ~VVE_Builder~
VERSION ~v1.0~

BEGIN ~Add NPC voiceovers~

OUTER_SET nrows = COUNT_2DA_ROWS ~mapping.2da~
OUTER_SET patched = 0

FOR (row = 0; row < nrows; row = row + 1) BEGIN

    OUTER_SET strref = ((READ_2DA_ENTRY_FORMER ~mapping.2da~ row 0 nrows))
    OUTER_SPRINT resref = ((READ_2DA_ENTRY_FORMER ~mapping.2da~ row 1 nrows))

    // The sound resref must exist as a resource (override), not just as a
    // file somewhere in the mod folder.
    COPY ~WAV/%resref%.WAV~ ~override/%resref%.WAV~

    // Grab the existing string text so the dialogue itself is untouched -
    // we're only attaching a sound file to an existing strref.
    ACTION_GET_STRREF ~%strref%~ dialogstring

    STRING_SET_EVALUATE ~%strref%~ ~%dialogstring%~ [~%resref%~]

    OUTER_SET patched = patched + 1

END

PRINT ~[VO Patcher] Patched %patched% strref(s) with voiceover.~
